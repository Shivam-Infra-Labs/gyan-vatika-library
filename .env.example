# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL connection variables (provided automatically in runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Strict Center Owner Gmail address for SUPER_ADMIN access in /admin
OWNER_EMAIL="mrs228891@gmail.com"

# Student session signing secret (auto-falls back to derived key in preview if unset)
STUDENT_SESSION_SECRET="change-me-in-production"

# Optional Center Coordinates for Attendance GPS Geo-Fence
NEXT_PUBLIC_CENTER_LAT="22.8152"
NEXT_PUBLIC_CENTER_LNG="86.0914"

# Optional Razorpay UPI gateway credentials (offline Cash/UPI active when absent)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional Google Maps Platform API key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
